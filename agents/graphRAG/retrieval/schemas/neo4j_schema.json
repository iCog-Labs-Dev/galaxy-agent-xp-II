{
  "nodes": {
    "Workflow": {
      "unique": "workflow_id",
      "fields": [
        "workflow_id",
        "name",
        "category",
        "file_name",
        "download_url",
        "number_of_steps",
        "readme",
        "has_readme",
        "has_changelog",
        "has_test_data",
        "planemo_tests"
      ]
    },
    "Step": {
      "unique": "step_uid",
      "fields": [
        "step_uid",
        "workflow_id",
        "step_id",
        "name",
        "type",
        "annotation",
        "tool_id",
        "tool_version",
        "input_connections",
        "tool_owner",
        "tool_repo",
        "tool_shed_url"
      ]
    },
    "Input": {
      "unique": "input_uid",
      "fields": [
        "input_uid",
        "workflow_id",
        "step_id",
        "name",
        "description"
      ]
    },
    "Output": {
      "unique": "output_uid",
      "fields": [
        "output_uid",
        "workflow_id",
        "step_id",
        "name",
        "description"
      ]
    },
    "Tool": {
      "unique": "tool_id",
      "fields": [
        "tool_id",
        "tool_uid",
        "name",
        "version",
        "repo_name",
        "owner",
        "description",
        "help"
      ]
    },
    "Category": {
      "unique": "category_id",
      "fields": [
        "category_id",
        "name"
      ]
    },
    "ToolCategory": {
      "unique": "category_id",
      "fields": [
        "category_id",
        "name"
      ]
    },
    "ToolInput": {
      "unique": "input_uid",
      "fields": [
        "input_uid",
        "tool_id",
        "name",
        "type",
        "accepts"
      ]
    },
    "ToolOutput": {
      "unique": "output_uid",
      "fields": [
        "output_uid",
        "tool_id",
        "name",
        "format"
      ]
    },
    "Keyword": {
      "unique": "name",
      "fields": ["name"]
    }
  },
  "relationships": {
    "HAS_WORKFLOW": {
      "from": "Category",
      "to": "Workflow",
      "fields": []
    },
    "HAS_STEP": {
      "from": "Workflow",
      "to": "Step",
      "fields": ["step_id"]
    },
    "USES_TOOL": {
      "from": "Step",
      "to": "Tool",
      "fields": []
    },
    "REQUIRES": {
      "from": "Workflow",
      "to": "Input",
      "fields": []
    },
    "GENERATES": {
      "from": "Workflow",
      "to": "Output",
      "fields": []
    },
    "STEP_REQUIRES": {
      "from": "Step",
      "to": "Input",
      "fields": []
    },
    "STEP_GENERATES": {
      "from": "Step",
      "to": "Output",
      "fields": []
    },
    "BELONGS_TO": {
      "from": "Tool",
      "to": "ToolCategory",
      "fields": []
    },
    "TOOL_HAS_INPUT": {
      "from": "Tool",
      "to": "ToolInput",
      "fields": []
    },
    "TOOL_HAS_OUTPUT": {
      "from": "Tool",
      "to": "ToolOutput",
      "fields": []
    },
    "HAS_KEYWORD": {
      "from": "Workflow",
      "to": "Keyword",
      "fields": []
    },
    "TOOL_HAS_KEYWORD": {
      "from": "Tool",
      "to": "Keyword",
      "fields": []
    },
    "SIMILAR_TO": {
      "from": "Tool",
      "to": "Tool",
      "fields": ["score"]
    }
  }
}
